{
  "name": "jinggong-agent",
  "version": "0.6.8",
  "private": true,
  "description": "精工Agent Windows 桌面客户端",
  "author": "精工研发",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "cli": "node scripts/cli.mjs",
    "dev": "npm run build && npm start",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "runtime:probe": "node scripts/probes/runtime-probe.mjs",
    "runtime:build:jinggong": "node scripts/build-jinggong-runtime.mjs",
    "pack": "npm run runtime:build:jinggong && npm run build && node scripts/stage-runtime.mjs && electron-builder --win --x64 --dir",
    "dist": "npm run runtime:build:jinggong && npm run build && node scripts/stage-runtime.mjs && electron-builder --win nsis --x64",
    "release:win": "npm run runtime:build:jinggong && npm run build && node scripts/stage-runtime.mjs && node scripts/release-win.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "electron-updater": "6.8.11",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openai/codex": "0.156.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.4.9",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.jinggong.agent",
    "productName": "精工Agent",
    "executableName": "JinggongAgent",
    "artifactName": "JinggongAgent-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/desktop/resources/runtime",
        "to": "runtime"
      },
      {
        "from": "apps/desktop/resources/cli/jinggong-agent.cmd",
        "to": "runtime/jinggong-agent.cmd"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "apps/desktop/resources/dictionaries",
        "to": "dictionaries"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "apps/desktop/resources/branding/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer/custom.nsh",
      "installerIcon": "apps/desktop/resources/branding/app.ico",
      "uninstallerIcon": "apps/desktop/resources/branding/app.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhuangxiaolong",
        "repo": "jg_agent",
        "releaseType": "release"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
